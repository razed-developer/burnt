{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Burnt",
  "version": "0.1.0",
  "identifier": "com.burnt.burner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Burnt",
        "width": 560,
        "height": 720,
        "minWidth": 420,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/ffprobe",
      "bin/ffmpeg",
      "bin/cdrdao"
    ],
    "resources": [
      "bin/msys-2.0.dll",
      "bin/msys-gcc_s-seh-1.dll",
      "bin/msys-iconv-2.dll",
      "bin/msys-stdc++-6.dll"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["cdrdao"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
